includes:
  - phpstan-baseline.neon

parameters:
  level: max
  paths:
    - %currentWorkingDirectory%/src
    - %currentWorkingDirectory%/tests
  excludePaths:
    - %currentWorkingDirectory%/src/DependencyInjection/Configuration.php # PHPStan's Symfony extension doesn't know how to work with the generics added in 7.4
  treatPhpDocTypesAsCertain: false
  ignoreErrors:
    -
      identifier: missingType.iterableValue
    -
      # The refreshed user check was added in Symfony 8.2, its tests are skipped on older versions
      message: '#CheckRefreshedUserEvent|RefreshedUserCheckerListener#'
      path: %currentWorkingDirectory%/tests/Authentication/Provider/SessionAuthenticationProviderTest.php
      reportUnmatched: false
