{
    "name": "babdev/websocket-bundle",
    "type": "symfony-bundle",
    "description": "Bundle integrating the WebSocket Server library with Symfony",
    "keywords": [
        "symfony",
        "WAMP",
        "websocket",
        "websocket server"
    ],
    "license": "MIT",
    "require": {
        "php": "8.4.* || 8.5.*",
        "babdev/websocket-server": "0.1.*",
        "guzzlehttp/psr7": "^2.13 || ^3.0",
        "psr/log": "^2.0 || ^3.0",
        "ratchet/rfc6455": "^0.4",
        "react/event-loop": "^1.5",
        "react/socket": "^1.16",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/console": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/event-dispatcher": "^7.4 || ^8.1",
        "symfony/event-dispatcher-contracts": "^2.0 || ^3.0",
        "symfony/framework-bundle": "^7.4 || ^8.1",
        "symfony/http-foundation": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "symfony/routing": "^7.4 || ^8.1",
        "symfony/security-core": "^7.4 || ^8.1"
    },
    "require-dev": {
        "doctrine/dbal": "^3.10 || ^4.0",
        "doctrine/doctrine-bundle": "^2.18 || ^3.0",
        "fig/log-test": "^1.2",
        "matthiasnoback/symfony-config-test": "^6.2",
        "matthiasnoback/symfony-dependency-injection-test": "^6.3",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "2.3.0",
        "phpstan/phpstan-phpunit": "2.1.0",
        "phpstan/phpstan-symfony": "2.1.0",
        "phpunit/phpunit": "13.4.1",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/container": "^1.0 || ^2.0",
        "psr/http-message": "^1.0 || ^2.0",
        "rector/rector": "2.7.0",
        "symfony/cache": "^7.4 || ^8.1",
        "symfony/phpunit-bridge": "^7.4 || ^8.1"
    },
    "conflict": {
        "doctrine/dbal": "<3.10 || >=5.0",
        "doctrine/doctrine-bundle": "<2.18 || >=4.0",
        "psr/cache": ">=4.0",
        "psr/container": ">=3.0",
        "psr/http-message": ">=3.0",
        "symfony/cache": "<7.4 || ~8.0.0 || >=9.0"
    },
    "suggest": {
        "ext-pcntl": "Required to stop the websocket server gracefully when the process receives a SIGINT, SIGTERM, or SIGQUIT signal"
    },
    "autoload": {
        "psr-4": {
            "BabDev\\WebSocketBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BabDev\\WebSocketBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev"
}
